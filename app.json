{
  "expo": {
    "name": "NDesk Browser",
    "slug": "NDeskBrowser",
    "scheme": "ndesk-browser",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0A0516"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.jpg",
      "infoPlist": {
        "NSFaceIDUsageDescription": "NDesk Browser uses Face ID to secure private browsing sessions."
      }
    },
    "android": {
      "package": "com.ndesk.browser",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0A0516",
        "foregroundImage": "./assets/icon.jpg"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.jpg"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NDesk Browser uses Face ID to unlock private browsing sessions."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "40100fe4-ad1d-4c28-bbdb-2ae1d1b8923b"
      }
    }
  }
}
